# ─────────────────────────────────────────────────────
# KrishiVaidya — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────

# -------- Core runtime --------
APP_ENV=dev
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# Session persistence
DATA_DIR=./data
STORE_FILE=./data/state_store.json

# -------- OpenAI --------
OPENAI_API_KEY=sk-...

# Model selection (default: gpt-4.1-mini)
OPENAI_MODEL=gpt-4.1-mini

# Optional: set if you use an OpenAI-compatible gateway
# OPENAI_BASE_URL=https://api.openai.com/v1

# -------- Tavily (web search) --------
TAVILY_API_KEY=tvly-...
TAVILY_MAX_RESULTS=5

# -------- OpenWeather One Call 3.0 --------
# Units: metric | imperial | standard
OPENWEATHER_API_KEY=
OPENWEATHER_UNITS=metric

# -------- Telegram Bot --------
TELEGRAM_BOT_TOKEN=
# Optional: restrict who can use the bot (comma-separated Telegram user IDs)
# Example: TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
TELEGRAM_ALLOWED_USER_IDS=

# -------- MySQL / XAMPP --------
STORE_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=krishivaidya
MYSQL_SESSIONS_TABLE=sessions
MYSQL_FARMERS_TABLE=farmers
MYSQL_IMAGES_TABLE=crop_images
